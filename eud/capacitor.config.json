{
  "appId": "com.lpu5.tactical",
  "appName": "LPU5 Tactical",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
