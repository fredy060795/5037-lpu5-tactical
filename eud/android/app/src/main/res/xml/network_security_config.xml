<?xml version="1.0" encoding="utf-8"?>
<!-- LPU5 servers usually run in the field LAN with HTTP or a self-signed
     certificate. Cleartext is allowed and certificates installed by the user
     (Settings > Security > Install certificate) are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
